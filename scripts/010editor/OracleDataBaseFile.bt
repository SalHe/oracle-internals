// fields named '_uxxxx' means unknown usage.
// fields named '_zxxxx' means zeros(maybe).

local uint8 UNKNOWN_HIDDEN=false;

LittleEndian();

typedef time_t OracleTimeStamp <comment=oracleTimestamp>;

uint64 paddingSize(uint64 padding, uint64 actualSize) {
    local uint64 remainder = actualSize % padding;
    if (remainder == 0) {
        return actualSize;
    }
    return actualSize + padding - remainder;
}

string oracleTimestamp(OracleTimeStamp& t) {
    return TimeTToString((int32)t + 545961600);
}

struct Scn {
    uint32 base;
    uint16 wrapper;
    uint16 _u1 <hidden=UNKNOWN_HIDDEN>;
};

struct FileMetaBlockHeader {
    uint8 _u1[20] <hidden=UNKNOWN_HIDDEN>;
    int32  blockSize;
    int32  blockCount;
    int32  magicNumber;
    int32  _u2 <hidden=UNKNOWN_HIDDEN>;
    Assert(magicNumber == 0x7A7B7C7D, "Magic number is not expected.");
};

struct RedoBlockHead {
    uint32 magicNumber;
    uint32 id;
    uint32 sequence;
    uint16 offset: 15;
    uint16 _u1:1  <hidden=UNKNOWN_HIDDEN>;
    uint16 checkSum;
    
    Assert(magicNumber == 0x00002201, "redo block magic number is not expected");
};

// https://jonathanlewis.wordpress.com/2017/07/25/redo-op-codes/
enum <uint8> RedoOpLayer {
    TX_CTL = 1,
    TX_READ = 2,
    TX_UPDATE = 3,
    BLK_CLEANOUT = 4,
    TX_UNDO_MANAGEMENT = 5,
    CTL_FILE = 6,
    INDEX = 10,
    TABLE = 11,
    CLUSTER = 12,
    SEG_MANAGEMENT = 13,
    EXTENT_MANAGEMENT = 14,
    TABLESPACE = 15,
    ROW_CACHE = 16,
    RECOVERY_MANAGEMENT = 17,
    BLOCK_IMAGE = 18,
    DIRECT_LOADER = 19,
    COMPATIBILITY = 20,
    LOB_SEG = 21,
    LOCALLY_MANABGMENT_TBS = 22,
    BLOCK_WRITES = 23,
    DDL_STATEMENTS = 24,
    QUEUES = 25,
    LOB = 26,
    BLOCK_CHANGE = 27,
};

struct RedoOp {
    RedoOpLayer layer;
    uint8 op;    
};

struct DataBlockAddr {
    uint32 blk: 22;
    uint32 file: 10;
};


typedef struct {
    RedoOp operation;
    uint16 blockClass <comment="CLS(Block Class)">;
    uint16 fileNumber <comment="AFN(Absolute File Number)">;
    uint16 objHigh;
    DataBlockAddr dba  <comment="DBA(Data Block Address">;
    Scn    scn;
    uint8  seq  <comment="SEQ(Sequence number relative to SCN)">;
    uint8  type <comment="TYP（Change type)">;
    uint16 objLow;
} ChangeHeader <comment=showChangeObj>;

struct Xid {
    uint16 usn <comment="Undo segment number (USN) of transaction">;
    uint16 httSlot <comment="Undo segment header transaction table slot">;
    uint32 sequence <comment="Sequence number (wrap)">;
};

struct Uba {
    DataBlockAddr undoDba <comment="DBA of undo block">;
    uint16 sequence <comment="Sequence number">;
    uint8  record <comment="Record number in block">;
    uint8  _u1 <hidden=UNKNOWN_HIDDEN>;
};

enum <uint8> XType {
    UNKNOWN,
    XA,
    XR,
    CR,    
};

struct ChangeVertorData(ChangeHeader& head, int index, uint16 size) {
    if (head.operation.layer == SEG_MANAGEMENT) {
        if (head.operation.op == 5) {
            // KTSFRBFMT (block format) redo
            if (index == 0) {
                uint32 obj <comment="Segobjd">;
                uint16 type;
                uint16 itls;
                return;
            }
            
            if (index == 1) {
                Scn scn;
                return;
            }
        }
        
        if (head.operation.op == 6) {
            // (block link modify) (? index )  (options: lock clear, lock set)
            uint32 opCode; // TODO 大小不太明确
            DataBlockAddr nextDba;
            uint32 itli; // TODO 大小不太明确
            return;
        }
        
        if (head.operation.op == 7) {
            // KTSFRGRP (fgb/shdr modify freelist) redo: (options unlink block, move HWM)
            if (index == 0) {
                // 1: HWMMV (move hwm)                
                uint32 opCode; // TODO 大小不太明确
                uint32 nbk;
                return;    
            }
            
            if (index == 1) {
                // 5: LUPD_LLIST (link a list)
                uint32 opCode; // TODO 大小不太明确
                uint32 slotCount;
                uint32 slotNo;
                uint32 flag;
                Xid    xid;
                uint32 head;
                uint32 tail;
                return;
            }
        }
    } else if (head.operation.layer == TABLE) {
        if (head.operation.op == 2) {
            // 11.2    IRP insert row  piece
            
            if (index == 0) {
                // KTB Redo
                uint8 op: 4; // 1=F
                uint8 cleanOut: 1;
                uint8 _u3: 3;
                
                uint8 ver: 2;
                uint8 compact: 1; // 0: (pre-11); 1: (post-11); 从字面意思来看，应该是区分是否为11之后的版本？TODO 需验证
                uint8 startFrom: 1; // 0: start from 4; 1: start from 8
                uint8 noPadding: 1; // https://github.com/bersler/OpenLogReplicator/blob/d8ac60b99b970a4d748e0b232170f2ed590b2427/src/parser/OpCode.h#L142
                uint8 _u2: 3;

                uint8 _u1[6];
                Xid xid;
                Uba uba;
                return;
            }
            
            if (index == 1) {
                local int begin = FTell();
                DataBlockAddr bdba;
                DataBlockAddr hdba;
                uint16 maxfr;
                
                // 2: IRP(Insert Row Piece)
                // 10: Set Key Links
                uint8 op: 5;
                uint8 _u2: 1;
                uint8 rowDependency: 1; // row dependencies Disabled/Enabled
                uint8 _u4: 1;
                
                // 1: XA, Redo
                // 2: XR, Rollback
                // 3: CR
                XType xType: 2;
                uint8 flags: 5;
                uint8 KDO_KDOM2: 1;
                
                uint8 itli;
                uint8 ispac;
                uint8 _u3[2];
                
                local int cost = FTell() - begin;
                
                /*
                uint32 fwd;
                uint16 fwdPos;
                uint32 bkw;
                uint16 bkwPos;
                
                // TODO 前两个标志位用于：Set Key Links
                uint8  inFwd: 1;
                uint8  inBkw: 1;
                uint8  flags2: 6;
                
                uint8  lock;
                uint8  slot;
                uint8 _u1[9];
                */
                if (op == 2) {
                    struct {
                        // fb: --H-FL-- lb: 0x1  cc: 1
                        union {
                            uint8 value;
                            struct {
                                uint8 N: 1 <comment="The last column continues in the Next piece">;
                                uint8 P: 1 <comment="The first column continues from the Previous piece">;
                                uint8 L: 1 <comment="Last ctx piece">;
                                uint8 F: 1 <comment="First ctx piece">;
                                uint8 D: 1 <comment="Deleted row">;
                                uint8 H: 1 <comment="Head piece of row">;
                                uint8 C: 1 <comment="Clustered table member">;
                                uint8 K: 1 <comment="Cluster Key">;
                            } flags;
                        } fb <comment="fb">;
                        uint8 lb <comment="lb">;
                        uint8 columnCount <comment="cc">;
                        uint8 cki; // fb.flags.C = 1
                        uint8 _u7[8];
                        DataBlockAddr nridDba;
                        uint16 nridSlot;
                        uint8 _u8[6];
        
                        uint16 deltaSize;
                        uint16 slot;
                        uint8 tabn;
                        uint8 nullsDelta[(int)Ceil((double)columnCount / 8)];
                        uint8 _u5[6];
                    } IRP;
                    return;
                }
                
                // TODO other OPs
                uint8 unrecognized[size - cost];
                return;
            }
            
            if (index == 2) {
                // 需要引用nulls才好识别列信息，目前好像解决不了
                uint8 colData[size];
                return;
            }
        }
    }
    uint8 unrecognized[size];
};


typedef struct {
    ChangeHeader head;
    uint32 _u1[2]; // TODO 这里与提供的资料有些出入，在21.3.0中，我导出的文件中是 changeListLen=1，实际changeList往后推了，可能是版本升级带来的
    uint16 changeListLen;
    
    if (changeListLen >= 2) {
        local uint16 vectorCount = changeListLen/2 - 1;
        uint16 changeVector[vectorCount];
        
        if ((changeListLen) % 4 != 0) {
            uint8  padding[4 - (changeListLen)%4];
        }
        
        local int begin;
        local int end;
        local int expectedSize;
        for (int i=0; i<vectorCount; i++) {
            begin = FTell();
            expectedSize = paddingSize(4, changeVector[i]);
            ChangeVertorData data(head, i, expectedSize); // TODO 可能会跨block，感觉010 editor不好解决啊
            end = FTell();
            Assert(end - begin == expectedSize, "change vector data size is not expected");
        }
    }
    
} Change;

string showChangeObj(ChangeHeader& c) {
    return Str("obj: %u", ((uint32)c.objHigh << 16) | (uint32)c.objLow);
}

struct _RedoBlock(int32 blockSize) {
    local uint64 blockBegin = FTell();
    
    RedoBlockHead head;
    
    
    local uint16 crossBlockRedoCotent = head.offset - sizeof(head);
    if (crossBlockRedoCotent > 0) {
        while (FTell() < blockBegin + head.offset) {
            Change change <optimize=false>;
        }
    } else {
        uint32 len <comment="LEN">;
        union {
            uint8 value;
            struct {
                uint8 KCRVALID: 1;
                uint8 KCRDEPND: 1;
                uint8 KCRVOID:  1;
                uint8 KCRNMARK: 1;
                uint8 KCRORDER: 1;
            uint8 UNKNOWN:  3 <hidden=UNKNOWN_HIDDEN>;
            } flags;
        } vld <comment="VLD">;
        uint8 _u1;
        uint16 subScn;
        Scn scn;
        
        if (vld.flags.KCRVOID) {
            uint8 _u[48];
            OracleTimeStamp beginTime;
        } else {
            Assert(0, "NOT IMPLMENTED");   
        }
        
        while (FTell() % blockSize != 0) {
            Change change <optimize=false>;
        }
    }
};

struct RedoBlock(int32 blockSize) {
    _RedoBlock content(blockSize);
    uint8 _u1[blockSize - sizeof(content)] <hidden=UNKNOWN_HIDDEN>; // size may be 0
};


/// Block#1
struct _RedoFileHeader {
    RedoBlockHead head;
    Assert(head.id == 1, "redo file header should be in block#1");
    
    uint32 _u3 <hidden=UNKNOWN_HIDDEN>;
    uint32 vsn <comment="Compatibility Vsn">;
    uint32 dbId <comment="Db ID">;
    char  dbName[8] <comment="Db Name">; // 看起来最多8字节：因为测试里给的名字被截断了
    uint32 controlSeq <comment="Control Seq">; // TODO：也有可能是short类型
    uint32 _u4[2] <hidden=UNKNOWN_HIDDEN>;
    uint16 fileNumber; // https://juejin.cn/post/6915191698217926664
    uint16 fileType; // https://juejin.cn/post/6915191698217926664
    uint32 activationId <comment="Activation ID">;
    uint8 _z1[36] <hidden=UNKNOWN_HIDDEN>;
    char  description[64];
    
    uint32 nab <comment="nab">;
    
    uint32 resetLogsCount <comment="resetlogs count">;
    Scn   resetLogsScn <comment="scn (resetlogs count)">;
    uint8 hws <comment="hws">;
    
    uint8 _u5[7] <hidden=UNKNOWN_HIDDEN>;
    
    Scn lowScn <comment="Low  scn">;
    OracleTimeStamp lowScnTimestamp;
    
    Scn nextScn <comment="Next scn">;
    OracleTimeStamp nextScnTimestamp;
    
    uint32 _u6 <hidden=UNKNOWN_HIDDEN>;
    
    Scn enabledScn <comment="Enabled scn">;
    OracleTimeStamp enabledScnTimestamp;
    
    Scn threadClosedScn <comment="Thread closed scn">;
    OracleTimeStamp threadClosedTimestamp;
    
    uint8 _u7[4] <hidden=UNKNOWN_HIDDEN>;
    
    uint32 miscFlags <comment="Miscellaneous flags">;
    uint32 miscFlags2 <comment="Miscellaneous second flags">;
    
    uint8 _u1[28] <hidden=UNKNOWN_HIDDEN>;
    Scn realNextScn <comment="Real next scn">;
    
    uint8 _u8[4] <hidden=UNKNOWN_HIDDEN>;
    
    Scn prevResetLogsScn <comment="scn (prev resetlogs count)">;
    uint32 prevResetLogsCount <comment="prev resetlogs count">;
    
    uint8 _z2[152] <hidden=UNKNOWN_HIDDEN>;

    uint8 logKey[16];
};

struct RedoFileHeader(int32 blockSize) {
    _RedoFileHeader content;
    uint8 _u1[blockSize - sizeof(content)] <hidden=UNKNOWN_HIDDEN>;
};

// Block#0
struct FileHeader {
    FileMetaBlockHeader content;
    uint8 _z1[content.blockSize - sizeof(content)] <hidden=UNKNOWN_HIDDEN>;
};

string showBlockId(RedoBlock& block) {
    return Str("Block#%u", block.content.head.id);
}

struct FILE {
    FileHeader     header <comment="Block#0">;
    RedoFileHeader redoHeader(header.content.blockSize) <comment="Block#1">;
    
    for (int i=0; i<header.content.blockCount-1; i++) {
        RedoBlock  redoBlock(header.content.blockSize) <comment=showBlockId, optimize=false>;    
    }
    
    Assert(FEof(), "Some remaining blocks?");
} file;

